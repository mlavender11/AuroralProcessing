   "metadata": {},
   "outputs": [],
   "source": [
    "# Process\n",
    "done = []\n",
    "errors = []\n",
    "for file in tqdm(files):\n",
    "    print(file.name)\n",
    "    out_dir = file.parent\n",
    "    try:\n",
    "        hdf_utils.make_keogram_rougher(hdf_path=file, out_dir=out_dir, bin_size_seconds=60, sample_interval=3600)\n",
    "        done.append(file)\n",
    "    except Exception as e:\n",
    "        errors.append((file, e))\n",
